    "react-dom": "19.1.0",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "prisma": "^6.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2"
  }
