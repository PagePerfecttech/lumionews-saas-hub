# ==============================================================================
# LUMIONEWS SAAS MASTER CONTROL PLANE & FLEET HUB
# ==============================================================================
# Environment Configuration for Vercel Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (e.g. from Neon.tech, Supabase, Railway, AWS RDS)
DATABASE_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/saas_hub_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. MASTER SUPER ADMIN AUTHENTICATION (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Master password used by you to log into the SaaS Hub dashboard
HUB_ADMIN_PASSWORD="ChooseAStrongAdminPassword2026!"

# Secret salt used for HMAC session cookies (generate random 32-hex string)
AUTH_SECRET="f6c8d7e9a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8"

# ------------------------------------------------------------------------------
# 3. RAZORPAY RECURRING BILLING & WEBHOOKS (REQUIRED FOR PAYMENTS)
# ------------------------------------------------------------------------------
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_custom_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. HOSTING & DOMAIN CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# The public live URL of this SaaS Hub deployment (e.g. on Vercel)
# Used to generate client .env templates and handle incoming webhooks
NEXT_PUBLIC_APP_URL="https://hub.yourdomain.com"
